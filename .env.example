# Copy to .env before running `docker compose up --build`.

# --- Database ---
MARIADB_ROOT_PASSWORD=rootpassword
DB_NAME=monitoring
DB_USER=monitoring
DB_PASSWORD=monitoring

# --- Backend ---
LOG_LEVEL=INFO
BACKEND_PORT=8000

# --- JWT ---
# Required. Generate your own: openssl rand -hex 32
JWT_SECRET_KEY=replace-me-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Realtime ---
REALTIME_INTERVAL_SECONDS=1.0
ANOMALY_THRESHOLD=80.0

# Realtime readings are written in batches: whichever trigger fires first.
BATCH_SIZE=10
BATCH_INTERVAL_SECONDS=5.0

# --- Frontend ---
FRONTEND_PORT=8501

# --- Demo accounts (LOCAL DEMONSTRATION ONLY) ---
# Seeded once, after migrations, if the account does not already exist.
# Existing accounts are never modified and passwords are never reset.
# CHANGE THESE FOR ANY NON-DEMO ENVIRONMENT. Leave a role's values blank to
# skip seeding it. Public registration always creates a USER regardless.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=demo-admin-pw

USER_USERNAME=user
USER_EMAIL=user@example.com
USER_PASSWORD=demo-user-pw

VIEWER_USERNAME=viewer
VIEWER_EMAIL=viewer@example.com
VIEWER_PASSWORD=demo-viewer-pw
