# Copy to .env before running `docker compose up --build`.

# --- Database ---
MARIADB_ROOT_PASSWORD=rootpassword
DB_NAME=monitoring
DB_USER=monitoring
DB_PASSWORD=monitoring

# --- Backend ---
LOG_LEVEL=INFO
BACKEND_PORT=8000

# --- JWT ---
# Required. Generate your own: openssl rand -hex 32
JWT_SECRET_KEY=replace-me-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Frontend ---
FRONTEND_PORT=8501
